<!-- app/src/main/res/values/styles.xml -->
<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#5C7680</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">#F2F2EE</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Custom semantic colors (Light) -->
        <item name="screenBackground">#F2F2EE</item>
        <item name="cardSurface">#FAFAF8</item>
        <item name="dividerColor">#ECECE8</item>
        <item name="titleAccentColor">#4A646C</item>
        <item name="sectionTitleColor">#5C7680</item>
        <item name="textPrimaryColor">#2B2B2B</item>
        <item name="textSecondaryColor">#6E6E6E</item>
        <item name="bottomBarBackground">#E3E6E8</item>
        <item name="bottomBarStroke">#FFFFFF</item>
        <item name="bottomNavTint">#556B73</item>
        <item name="bottomNavText">#4A5D64</item>
    </style>

    <style name="CustomSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/switch_track_selector</item>
        <item name="thumbTint">#FFFFFF</item>
    </style>
</resources>
